{
  "name": "backoffice",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "description": "Backoffice da plataforma Astro",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "ai:fixtures": "tsx scripts/ai-fixtures.ts",
    "test:coverage": "tsx --test --experimental-test-coverage tests/**/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "smoke:production": "node scripts/smoke-production.mjs",
    "docker:build": "docker build -t astro-backoffice .",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "ASTRO_API_URL=https://api.astroengine.com.br NEXT_PUBLIC_ASTRO_API_URL=https://api.astroengine.com.br NEXT_PUBLIC_CHECKOUT_URL=https://checkout.astroengine.com.br NEXT_PUBLIC_LANDING_URL=https://astroengine.com.br VINEXT_CLOUDFLARE=1 vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "ASTRO_API_URL=https://api.astroengine.com.br NEXT_PUBLIC_ASTRO_API_URL=https://api.astroengine.com.br NEXT_PUBLIC_CHECKOUT_URL=https://checkout.astroengine.com.br NEXT_PUBLIC_LANDING_URL=https://astroengine.com.br VINEXT_CLOUDFLARE=1 vinext-cloudflare deploy"
  },
  "dependencies": {
    "@astro/checkout-renderer": "file:../checkout-renderer",
    "@puckeditor/core": "0.22.2",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.13.0",
    "@xyflow/react": "12.8.6",
    "driver.js": "^1.8.0",
    "motion": "^13.1.1",
    "next": "16.4.1",
    "postcss": "8.5.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.9.2",
    "sharp": "0.35.5",
    "vinext": "1.4.5",
    "react-server-dom-webpack": "19.3.1",
    "@vinext/cloudflare": "1.3.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vite": "8.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "cf": "1.0.0-beta.32"
  },
  "type": "module"
}
